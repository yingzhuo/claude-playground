<?xml version="1.0" encoding="UTF-8"?>
<configuration debug="false" scan="true" scanPeriod="30 seconds" packagingData="false">

	<springProperty name="LOG_HOME" source="logback.log-home"/>
	<springProperty name="LOG_NAME" source="logback.log-name"/>
	<springProperty name="LOG_PATTERN" source="logback.log-pattern"/>

	<!-- 导入logback类型 -->
	<import class="ch.qos.logback.core.ConsoleAppender"/>
	<import class="ch.qos.logback.core.rolling.RollingFileAppender"/>
	<import class="ch.qos.logback.core.rolling.SizeAndTimeBasedRollingPolicy"/>
	<import class="ch.qos.logback.classic.encoder.PatternLayoutEncoder"/>

	<!-- log精细配置 -->
	<logger name="io.github.yingzhuo.claude" level="debug"/>
	<logger name="org.springframework" level="info"/>
	<logger name="org.springframework.jdbc.datasource.DataSourceTransactionManager" level="debug"/>
	<logger name="org.springframework.boot.context.ApplicationPidFileWriter" level="off"/>
	<logger name="org.springframework.security" level="debug"/>
	<logger name="org.springframework.security.access.hierarchicalroles.RoleHierarchyImpl" level="info"/>
	<logger name="org.springframework.security.config.annotation.web.builders.WebSecurity" level="off"/>
	<logger name="org.hibernate.validator" level="warn"/>
	<logger name="org.jboss.logging" level="warn"/>
	<logger name="com.zaxxer.hikari" level="info"/>
	<logger name="com.tngtech" level="info"/>
	<logger name="io.swagger" level="info"/>
	<logger name="com.baomidou" level="info"/>
	<logger name="org.mybatis" level="info"/>
	<logger name="org.apache.ibatis" level="info"/>

	<!-- DAO层 -->
	<logger name="io.github.yingzhuo.claude.core.m.user.dao" level="debug"/>

	<springProfile name="dev, docker">
		<appender name="STDOUT" class="ConsoleAppender">
			<encoder class="PatternLayoutEncoder">
				<pattern>[%d{yyyy-MM-dd HH:mm:ss.SSS}]%-5level %logger{72}[%L] - %msg%n</pattern>
			</encoder>
		</appender>

		<root level="debug">
			<appender-ref ref="STDOUT"/>
		</root>
	</springProfile>

</configuration>
